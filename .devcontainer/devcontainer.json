{
  "name": "Elite Dangerous Ship Builder",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // Persist Claude state from the host. Codex state remains container-local;
  // its writable defaults are seeded by the Dockerfile.
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/node/.claude,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude.json,target=/home/node/.claude.json,type=bind"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "angular.ng-template",
        "ms-playwright.playwright",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "anthropic.claude-code",
        "openai.chatgpt"
      ]
    }
  },

  "forwardPorts": [1455, 4200, 4300, 4400],

  "portsAttributes": {
    "1455": {
      "label": "Codex login callback",
      "onAutoForward": "silent",
      "requireLocalPort": true
    },
    "4200": {
      "label": "Angular dev server",
      "onAutoForward": "openBrowser"
    },
    "4300": {
      "label": "Component preview catalogue",
      "onAutoForward": "silent"
    },
    "4400": {
      "label": "Production build (offline journey)",
      "onAutoForward": "silent"
    }
  },

  "remoteUser": "node",
  "postCreateCommand": "node --version && python3 --version && pnpm --version && pnpm install --frozen-lockfile && pnpm exec playwright install --with-deps chromium firefox"
}
