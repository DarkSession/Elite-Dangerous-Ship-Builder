{
  "name": "Elite Dangerous Ship Builder",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "runArgs": ["--privileged"],

  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": true
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // Persist Claude Code auth/config from the host into the container
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/node/.claude,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude.json,target=/home/node/.claude.json,type=bind"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "angular.ng-template",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "anthropic.claude-code",
        "openai.chatgpt"
      ]
    }
  },

  "forwardPorts": [4200],

  "remoteUser": "node",
  "postCreateCommand": "node --version && python3 --version && pnpm --version && pnpm install --frozen-lockfile"
}
