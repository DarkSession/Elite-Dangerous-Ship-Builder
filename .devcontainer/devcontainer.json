{
  "name": "Elite Dangerous Ship Builder",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // Persist host tool state, but override Codex config for this container only
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/node/.claude,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude.json,target=/home/node/.claude.json,type=bind",
    "source=elite-dangerous-ship-builder-codex,target=/home/node/.codex,type=volume",
    "source=${localWorkspaceFolder}/.devcontainer/codex-config.toml,target=/home/node/.codex/config.toml,type=bind,readonly"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "angular.ng-template",
        "ms-playwright.playwright",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "anthropic.claude-code",
        "openai.chatgpt"
      ]
    }
  },

  "forwardPorts": [1455, 4200],

  "portsAttributes": {
    "1455": {
      "label": "Codex login callback",
      "onAutoForward": "silent",
      "requireLocalPort": true
    }
  },

  "remoteUser": "node",
  "postCreateCommand": "node --version && python3 --version && pnpm --version && pnpm install --frozen-lockfile && pnpm exec playwright install --with-deps chromium"
}
