/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /*
     * `node` is here for one reason: the Almanac anatomy contract suite reads
     * the installed package's schematic files off disk and runs the real parser
     * over every one of them. Vitest runs specs in Node with a jsdom document,
     * so both halves are available in the same file — which is what keeps the
     * audit and the parser it audits from drifting apart. No other suite needs
     * it, and a spec reaching for `node:fs` to avoid a seam is still wrong.
     */
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts"]
}
