{
  "name": "elite-dangerous-ship-builder",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "e2e": "playwright test --grep-invert \"candidate search timing\"",
    "e2e:timing": "playwright test --project=chromium-mobile-timing --workers=1",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "ui:preview": "ng serve ui-preview",
    "e2e:preview": "playwright test ui-preview.spec.ts",
    "e2e:offline": "E2E_PRODUCTION=1 playwright test offline.spec.ts offline-privacy.spec.ts schematic-offline.spec.ts",
    "policy": "node scripts/check-interface-foundations.mjs && node scripts/policy/outfitting-ownership.mjs && node scripts/policy/anatomy-ownership.mjs",
    "codec:tables": "node scripts/generate-build-link-codec-tables.mjs && prettier --write src/app/domain/build-link/codec-table-1.json",
    "codec:capacity": "node scripts/build-link-codec-capacity.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit && tsc -p projects/ui-preview/tsconfig.app.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run build && pnpm run build:preview && pnpm run policy && pnpm run codec:capacity && pnpm run test:scripts && pnpm run test && pnpm run e2e && pnpm run e2e:timing && pnpm run e2e:offline",
    "build:preview": "ng build ui-preview"
  },
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/service-worker": "^22.1.3",
    "@elite-dangerous-almanac/core": "0.1.5",
    "@jsverse/transloco": "^8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.26",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
